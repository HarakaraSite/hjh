{
  "defaultRole": "default",
  "model": {
    "provider": "openrouter-responses",
    "api": "responses",
    "authProfile": "openrouter-api-key",
    "modelId": "deepseek/deepseek-v4.1-flash",
    "effort": "auto"
  },
  "credentials": {
    "openrouter-api-key": {
      "env": "OPENROUTER_API_KEY",
      "file": "~/.local/state/henji-harness/v1/credentials/openrouter-api-key"
    },
    "opencode-go-api-key": {
      "env": "OPENCODE_GO_API_KEY",
      "file": "~/.local/state/henji-harness/v1/credentials/opencode-go-api-key"
    },
    "openai-api-key": {
      "env": "OPENAI_API_KEY",
      "file": "~/.local/state/henji-harness/v1/credentials/openai-api-key"
    }
  },
  "providers": {
    "openrouter-responses": {
      "displayName": "OpenRouter Responses",
      "api": "responses",
      "baseURL": "https://openrouter.ai/api/v1",
      "path": "/responses",
      "auth": {"kind": "api-key", "profile": "openrouter-api-key"},
      "defaultModel": "deepseek/deepseek-v4.1-flash",
      "defaultEffort": "auto",
      "catalog": {"kind": "openai", "path": "/models"},
      "models": [
        {"id": "deepseek/deepseek-v4.1-flash", "name": "DeepSeek V4.1 Flash"}
      ],
      "adapter": {"store": false, "reasoningReplay": true}
    },
    "opencode-go-chat": {
      "displayName": "OpenCode Go Chat Completions",
      "api": "chat-completions",
      "baseURL": "https://opencode.ai/zen/go/v1",
      "path": "/chat/completions",
      "auth": {"kind": "api-key", "profile": "opencode-go-api-key"},
      "defaultModel": "deepseek-v4.1-flash",
      "defaultEffort": "auto",
      "models": [
        {"id": "deepseek-v4.1-flash", "name": "DeepSeek V4.1 Flash", "efforts": ["low", "high", "max"]},
        {"id": "deepseek-v4-pro", "name": "DeepSeek V4 Pro"},
        {"id": "deepseek-v4-flash", "name": "DeepSeek V4 Flash"},
        {"id": "deepseek-v4-flash-vision-exp", "name": "DeepSeek V4 Flash Vision Exp"},
        {"id": "glm-5.3-flash", "name": "GLM-5.3-Flash"},
        {"id": "glm-5.3", "name": "GLM-5.3"},
        {"id": "glm-5.2", "name": "GLM-5.2"},
        {"id": "kimi-k3", "name": "Kimi K3"},
        {"id": "kimi-k2.7-code", "name": "Kimi K2.7 Code"},
        {"id": "kimi-k2.6", "name": "Kimi K2.6"},
        {"id": "longcat-2.0", "name": "LongCat-2.0"},
        {"id": "longcat-2.5-preview-free", "name": "LongCat 2.5 Preview Free"},
        {"id": "mimo-v2.6-flash", "name": "MiMo-V2.6-Flash"},
        {"id": "mimo-v2.6-pro", "name": "MiMo-V2.6-Pro"},
        {"id": "mimo-v2.5", "name": "MiMo-V2.5"},
        {"id": "mimo-v2.5-pro", "name": "MiMo-V2.5-Pro"},
        {"id": "hy4-preview", "name": "Hy4 preview"},
        {"id": "hy3", "name": "Hy3"},
        {"id": "space-bunny", "name": "Space Bunny"}
      ],
      "headers": {"User-Agent": "hjh"},
      "sessionHeader": "x-opencode-session"
    },
    "opencode-go-responses": {
      "displayName": "OpenCode Go Responses",
      "api": "responses",
      "baseURL": "https://opencode.ai/zen/go/v1",
      "path": "/responses",
      "auth": {"kind": "api-key", "profile": "opencode-go-api-key"},
      "defaultModel": "gpt-6-luna",
      "defaultEffort": "auto",
      "models": [
        {"id": "gpt-6-luna", "name": "GPT 6 Luna"},
        {"id": "gpt-5.6-luna", "name": "GPT 5.6 Luna"},
        {"id": "grok-4.7", "name": "Grok 4.7"},
        {"id": "grok-4.6", "name": "Grok 4.6"},
        {"id": "muse-spark-1.3-contributor", "name": "Muse Spark 1.3 Contributor"},
        {"id": "muse-spark-1.2-contributor", "name": "Muse Spark 1.2 Contributor"}
      ],
      "headers": {"User-Agent": "hjh"},
      "sessionHeader": "x-opencode-session"
    },
    "openai-responses": {
      "displayName": "OpenAI API Responses",
      "api": "responses",
      "modelsDevProviderId": "openai",
      "baseURL": "https://api.openai.com/v1",
      "path": "/responses",
      "auth": {"kind": "api-key", "profile": "openai-api-key"},
      "defaultModel": "gpt-6-luna",
      "defaultEffort": "auto",
      "models": [
        {"id": "gpt-6-luna", "name": "GPT 6 Luna"}
      ]
    },
    "openai-chatgpt": {
      "displayName": "ChatGPT Responses",
      "api": "responses",
      "modelsDevProviderId": "openai",
      "baseURL": "https://api.openai.com/v1",
      "path": "/responses",
      "auth": {"kind": "chatgpt-oauth", "profile": "hjh-chatgpt"},
      "defaultModel": "gpt-6.1-sol",
      "defaultEffort": "auto",
      "catalog": {"kind": "openai-account", "path": "/models"},
      "adapter": {"store": false, "namespaceTools": true, "reasoningReplay": true}
    }
  },
  "roles": {
    "default": {
      "revision": "1",
      "description": "General-purpose work role that completes requests and verifies the result.",
      "instruction": "Complete the requested work, verify the result with the available tools, and report what changed. Use web_fetch to read web pages; use http when a raw HTTP response is needed.",
      "tools": ["run_js", "run_agent", "spawn_agent", "agent_status", "steer_agent", "collect_agent", "cancel_agent", "read_file", "write_file", "edit_file", "command", "http", "web_fetch"]
    },
    "reviewer": {
      "revision": "1",
      "description": "Reviews source and behavior against the stated goal and actual execution path.",
      "instruction": "Review the stated goal and relevant source paths. Report findings with evidence and user impact; distinguish confirmed defects from uncertainty.",
      "tools": ["run_js", "read_file"]
    }
  },
  "systemInstruction": "",
  "instructionComponents": [],
  "toolPaths": ["index.js"],
  "tools": [
    {
      "name": "read_file",
      "description": "Read a UTF-8 text file from the workspace.",
      "inputSchema": {"type":"object","properties":{"path":{"type":"string"}},"required":["path"]},
      "module": "index.js",
      "export": "readFile"
    },
    {
      "name": "write_file",
      "description": "Create or replace a UTF-8 text file in the workspace.",
      "inputSchema": {"type":"object","properties":{"path":{"type":"string"},"text":{"type":"string"}},"required":["path","text"]},
      "module": "index.js",
      "export": "writeFile"
    },
    {
      "name": "edit_file",
      "description": "Replace every exact occurrence of oldText with newText in a UTF-8 text file.",
      "inputSchema": {"type":"object","properties":{"path":{"type":"string"},"oldText":{"type":"string"},"newText":{"type":"string"}},"required":["path","oldText","newText"]},
      "module": "index.js",
      "export": "editFile"
    },
    {
      "name": "command",
      "description": "Run a program in the workspace and return its exit code, stdout, and stderr.",
      "inputSchema": {"type":"object","properties":{"program":{"type":"string"},"args":{"type":"array","items":{"type":"string"}},"stdin":{"type":"string"}},"required":["program"]},
      "module": "index.js",
      "export": "command"
    },
    {
      "name": "http",
      "description": "Make a raw HTTP GET request and return its status and body. Use web_fetch to read web pages as text.",
      "inputSchema": {"type":"object","properties":{"url":{"type":"string"}},"required":["url"]},
      "module": "index.js",
      "export": "http"
    },
    {
      "name": "web_fetch",
      "description": "Read an http or https page or API response. HTML is converted to readable text; text responses are limited to 1 MiB. Set save_to to save the original response bytes to a workspace-relative or absolute path without returning the body.",
      "inputSchema": {"type":"object","properties":{"url":{"type":"string"},"save_to":{"type":"string"}},"required":["url"],"additionalProperties":false},
      "module": "index.js",
      "export": "webFetch"
    },
    {
      "name": "run_agent",
      "revision": "1",
      "description": "Run an independent task as a child agent.",
      "promptGuidelines": [
        "Use run_agent to delegate an independent task. Include the context the child needs in task because its conversation is independent.",
        "It accepts optional role, model selection (provider, modelId, effort), and tool list values; the result includes executionId and outcome, with optional finalText or error."
      ],
      "inputSchema": {"type":"object","properties":{"task":{"type":"string"},"role":{"type":"string"},"model":{"type":"object","properties":{"provider":{"type":"string"},"modelId":{"type":"string"},"effort":{"type":"string"}}},"tools":{"type":"array","items":{"type":"string"}}},"required":["task"]},
      "module": "run-agent.js",
      "export": "runAgent"
    },
    {
      "name": "spawn_agent",
      "revision": "1",
      "description": "Start a child agent.",
      "promptGuidelines": [
        "Use spawn_agent to start independent child work. Its conversation is independent, so include necessary context in task. It returns an executionId while running and accepts optional role, model selection (provider, modelId, effort), and tools list values.",
        "Start independent children before collecting when useful, and continue your own work between starting and collecting."
      ],
      "inputSchema": {"type":"object","properties":{"task":{"type":"string"},"role":{"type":"string"},"model":{"type":"object","properties":{"provider":{"type":"string"},"modelId":{"type":"string"},"effort":{"type":"string"}}},"tools":{"type":"array","items":{"type":"string"}}},"required":["task"]},
      "module": "agent-control.js",
      "export": "spawnAgent"
    },
    {
      "name": "agent_status",
      "revision": "1",
      "description": "Read a child agent's current state.",
      "promptGuidelines": [
        "Use agent_status after starting independent work to read the child's state, progress, latest instruction receipts, and saved assistant reports. Omit after to receive all reports, then pass nextCursor as after to read newer ones.",
        "Reports include source executionId and messageOrdinal; repeated reads do not advance a shared cursor. Do not poll status to wait for completion.",
        "Steer receipts can be accepted, applied, or unapplied. Accepted means the guidance was saved; applied means it entered the child's loop. Neither means the model followed it."
      ],
      "inputSchema": {"type":"object","properties":{"executionId":{"type":"string"},"after":{"type":"integer"}},"required":["executionId"]},
      "module": "agent-control.js",
      "export": "agentStatus"
    },
    {
      "name": "steer_agent",
      "revision": "1",
      "description": "Send additional guidance to an active child agent.",
      "promptGuidelines": [
        "Use steer_agent to save additional guidance for an active child and receive its accepted receipt.",
        "The child finishes its current model request and tools before receiving the guidance at a loop boundary."
      ],
      "inputSchema": {"type":"object","properties":{"executionId":{"type":"string"},"text":{"type":"string"}},"required":["executionId","text"]},
      "module": "agent-control.js",
      "export": "steerAgent"
    },
    {
      "name": "collect_agent",
      "revision": "1",
      "description": "Collect a child agent's result.",
      "promptGuidelines": [
        "Use collect_agent when you need a spawned child's settled result; it waits for that child to finish."
      ],
      "inputSchema": {"type":"object","properties":{"executionId":{"type":"string"}},"required":["executionId"]},
      "module": "agent-control.js",
      "export": "collectAgent"
    },
    {
      "name": "cancel_agent",
      "revision": "1",
      "description": "Cancel a child agent.",
      "promptGuidelines": [
        "Use cancel_agent when a started child should stop; it waits for and returns the child's settled result."
      ],
      "inputSchema": {"type":"object","properties":{"executionId":{"type":"string"}},"required":["executionId"]},
      "module": "agent-control.js",
      "export": "cancelAgent"
    }
  ],
  "hooks": "hooks.js",
  "rejections": []
}
