  "oldSemverBytes": 66433,
  "oldSemverSHA256": "34086258a0c5b8c6408983beee79158d8d23f596f2ec2fa240e904d86aec9083",
  "oldSourceBytes": {
    "hook-config.yaml": "note: prepared\n",
    "hooks.js": "import { parse } from './vendor/yaml/index.js';\n\nexport async function beforeTool({ name, args }, api) {\n  if (name !== 'catalog') return args;\n  const file = await api.readFile({ path: args.hookConfigPath });\n  const config = parse(file.text);\n  return { ...args, note: config.note + ':hook-one' };\n}\n\nexport async function afterTool({ name, result }) {\n  return name === 'catalog' ? { ...result, hookRevision: 'hook-one' } : result;\n}\n",
    "modules/catalog.js": "import { parse } from '../vendor/yaml/index.js';\nimport semver from '../vendor/semver/index.mjs';\n\nexport async function catalog(args, api) {\n  const response = await api.tools.http({ url: args.url });\n  const manifest = parse(response.body);\n  const compatible = manifest.dependencies\n    .filter(dep =\u003e semver.satisfies(dep.candidate, dep.range))\n    .map(dep =\u003e ({ name: dep.name, version: semver.valid(dep.candidate) }));\n  return { project: manifest.project, compatible, note: args.note, toolRevision: 'tool-one' };\n}\n"
  }
